#!/bin/bash

# Deprecated: use `scripts/iac bootstrap`. This shim translates the old
# `bootstrap [OPTIONS] TARGET_DIR` form and will be removed.
#
# The old --force erased TARGET_DIR/infrastructure, production included.
# Bootstrap now only creates what is missing, so --force is refused.

set -euo pipefail

main() {
    local script_dir target=""
    local options=()
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    while [[ $# -gt 0 ]]; do
        case $1 in
            --force)
                die "--force is gone: bootstrap no longer erases anything. \
Run it without --force to create whatever is missing."
                ;;
            -*)
                options+=("$1")
                ;;
            *)
                [[ -z "$target" ]] || die "Too many arguments"
                target="$1"
                ;;
        esac
        shift
    done

    echo "WARNING: scripts/bootstrap is deprecated; use scripts/iac bootstrap" >&2
    [[ -n "$target" ]] && options+=(--target "$target")
    exec "$script_dir/iac" bootstrap ${options[@]+"${options[@]}"}
}

die() {
    echo "ERROR: $1" >&2
    exit 1
}

main "$@"
