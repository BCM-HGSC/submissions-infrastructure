#!/bin/bash

# Deprecated: use `scripts/iac engine`. This shim translates the old
# `bootstrap-engine [OPTIONS] TARGET_DIR` form and will be removed.
#
# -y/--yes is accepted and ignored: the install never prompts.
# The old --force only skipped the disk check; it becomes --skip-disk-check.

set -euo pipefail

main() {
    local script_dir target=""
    local options=()
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    while [[ $# -gt 0 ]]; do
        case $1 in
            -y|--yes)
                ;;
            --force)
                options+=(--skip-disk-check)
                ;;
            -*)
                options+=("$1")
                ;;
            *)
                [[ -z "$target" ]] || die "Too many arguments"
                target="$1"
                ;;
        esac
        shift
    done

    echo "WARNING: scripts/bootstrap-engine is deprecated; use scripts/iac engine" >&2
    [[ -n "$target" ]] && options+=(--target "$target")
    exec "$script_dir/iac" engine ${options[@]+"${options[@]}"}
}

die() {
    echo "ERROR: $1" >&2
    exit 1
}

main "$@"
