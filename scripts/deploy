#!/bin/bash

# Deprecated: use `scripts/iac deploy`. This shim translates the old
# `deploy TARGET_DIR TIER [OPTIONS]` form and will be removed.
#
# The old --force meant two things; it becomes --overwrite --skip-disk-check.

set -euo pipefail

main() {
    local script_dir target="" tier=""
    local options=()
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    while [[ $# -gt 0 ]]; do
        case $1 in
            --force)
                options+=(--overwrite --skip-disk-check)
                ;;
            -*)
                options+=("$1")
                ;;
            *)
                if [[ -z "$target" ]]; then
                    target="$1"
                elif [[ -z "$tier" ]]; then
                    tier="$1"
                else
                    die "Too many arguments"
                fi
                ;;
        esac
        shift
    done

    echo "WARNING: scripts/deploy is deprecated; use scripts/iac deploy" >&2
    [[ -n "$target" ]] && options+=(--target "$target")
    [[ -n "$tier" ]] && options+=(--tier "$tier")
    exec "$script_dir/iac" deploy ${options[@]+"${options[@]}"}
}

die() {
    echo "ERROR: $1" >&2
    exit 1
}

main "$@"
